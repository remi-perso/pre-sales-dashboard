# Shared PostgreSQL database used only by app-owned mapping and override APIs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Browser-visible Salesforce defaults. The session ID is never configured here.
NEXT_PUBLIC_SALESFORCE_INSTANCE_URL="https://your-domain.my.salesforce.com"
NEXT_PUBLIC_SALESFORCE_API_VERSION="v65.0"

# Optional one-line JSON mapping for org-specific Opportunity API names.
# Product Line / Region are source-scoped to Okta / UKI when left null.
# NEXT_PUBLIC_SALESFORCE_FIELD_MAP_JSON='{"presalesStage":"Presales_Stage__c","technicalWinDate":"Technical_Win_Date__c","lastStageChangeDate":"Last_Stage_Change_Date__c","productLine":null,"region":null}'
